# kajota-hub reverse proxy.
#
# `handle_path` STRIPS the matched prefix, so each app receives requests at
# its own root (/healthz, /chat, /api/v1/...) exactly as it does today when
# deployed standalone. We also forward X-Forwarded-Prefix so any app that
# later wants to generate absolute self-URLs (e.g. coach-okx's x402 pay URL)
# can honor its mount point via FastAPI root_path — see README "Known limits".
{
	admin off
	auto_https off
	# Trust Render's TLS-terminating proxy (private IP) so the ORIGINAL
	# X-Forwarded-Proto (https) is preserved to the backends instead of being
	# overwritten with Caddy's own http listener scheme. Apps build their x402
	# `resource` URL from X-Forwarded-Proto + X-Forwarded-Prefix.
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:10000} {
	# Proxy-level liveness — this is what Render's healthCheckPath hits.
	handle /healthz {
		respond "ok" 200
	}

	handle_path /coach-okx/* {
		reverse_proxy 127.0.0.1:8101 {
			header_up X-Forwarded-Prefix /coach-okx
		}
	}
	handle_path /mesh-okx/* {
		reverse_proxy 127.0.0.1:8102 {
			header_up X-Forwarded-Prefix /mesh-okx
		}
	}
	handle_path /concierge/* {
		reverse_proxy 127.0.0.1:8103 {
			header_up X-Forwarded-Prefix /concierge
		}
	}
	handle_path /slack/* {
		reverse_proxy 127.0.0.1:8104 {
			header_up X-Forwarded-Prefix /slack
		}
	}
	# Bare /mesh-skill[/] gets a static 200 for the operator-dashboard probe —
	# the FastAPI app has no root handler of its own and would 404 otherwise.
	# Real endpoints (/healthz, /escrow/*, /docs) still reverse_proxy as normal.
	@mesh_skill_root path /mesh-skill /mesh-skill/
	handle @mesh_skill_root {
		header Content-Type application/json
		respond `{"ok":true,"service":"mesh-skill","health":"/mesh-skill/healthz","docs":"/mesh-skill/docs"}` 200
	}
	handle_path /mesh-skill/* {
		reverse_proxy 127.0.0.1:8105 {
			header_up X-Forwarded-Prefix /mesh-skill
		}
	}
	handle_path /witness/* {
		reverse_proxy 127.0.0.1:8106 {
			header_up X-Forwarded-Prefix /witness
		}
	}
	# Bare /judge -> /judge/ so the demo page's relative fetch("challenge"/"pay")
	# resolve under the mount instead of the hub root.
	handle /judge {
		redir * /judge/ permanent
	}
	handle_path /judge/* {
		reverse_proxy 127.0.0.1:8107 {
			header_up X-Forwarded-Prefix /judge
		}
	}
	# /judge-casper is the operator-dashboard-friendly alias for /judge — kept
	# in sync so the Casper Final Round judge demo URL survives whichever name
	# the dashboard probe ends up using. Same upstream (8107), same prefix header
	# (/judge) so the demo page's relative fetches resolve correctly either way.
	handle /judge-casper {
		redir * /judge-casper/ permanent
	}
	handle_path /judge-casper/* {
		reverse_proxy 127.0.0.1:8107 {
			header_up X-Forwarded-Prefix /judge
		}
	}
	# Same story for keeperhub-escrow — the console's relative fetch("config",
	# "status", "demo-release") must resolve under /keeperhub/, not the hub root.
	handle /keeperhub {
		redir * /keeperhub/ permanent
	}
	handle_path /keeperhub/* {
		reverse_proxy 127.0.0.1:8108 {
			header_up X-Forwarded-Prefix /keeperhub
		}
	}
	# /keeper-hub is the operator-dashboard-friendly alias for /keeperhub.
	# Same upstream (8108), same prefix header (/keeperhub) so the console's
	# relative fetches resolve correctly under either mount.
	handle /keeper-hub {
		redir * /keeper-hub/ permanent
	}
	handle_path /keeper-hub/* {
		reverse_proxy 127.0.0.1:8108 {
			header_up X-Forwarded-Prefix /keeperhub
		}
	}

	# Payflow — NIP payment-ops triage. Two integrations (freshdesk, zendesk)
	# on separate ports. HMAC signatures are over the body only, so the strip
	# via handle_path is invisible to signature verification upstream.
	handle_path /payflow-freshdesk/* {
		reverse_proxy 127.0.0.1:8109 {
			header_up X-Forwarded-Prefix /payflow-freshdesk
		}
	}
	handle_path /payflow-zendesk/* {
		reverse_proxy 127.0.0.1:8110 {
			header_up X-Forwarded-Prefix /payflow-zendesk
		}
	}

	# Shield — static confidential agent-payment console. No backend process:
	# the page is self-contained (inlined run data), so Caddy file-serves it directly.
	handle /shield {
		redir * /shield/ permanent
	}
	handle_path /shield/* {
		root * /srv/apps/shield
		file_server
	}

	# Beacon — Mandate Beacon inspector (Vite SPA). Static like Shield; the
	# dist/ is pre-built from kajota-zama/beacon and vendored into apps/beacon/
	# by scripts/vendor-beacon.sh. BLI Legal Tech Hackathon 2 submission surface
	# — three live Sepolia contracts (MandateAnchor + SakkMandate + EsusuMandate)
	# rendered as inspector tabs with a 2D/3D toggle. The beacon-sepolia.json
	# manifest gets a short s-maxage so the browser refreshes anchor rows within
	# one anchor-cron tick without hammering the hub origin.
	handle /beacon {
		redir * /beacon/ permanent
	}
	@beacon_manifest path /beacon/beacon-sepolia.json
	handle @beacon_manifest {
		header Cache-Control "public, max-age=0, s-maxage=300, must-revalidate"
		rewrite * /beacon-sepolia.json
		root * /srv/apps/beacon
		file_server
	}
	handle_path /beacon/* {
		root * /srv/apps/beacon
		try_files {path} /index.html
		file_server
	}

	# IELTS × SD × PhD prep — sync backend for the Vercel-hosted React app.
	# Single-user, bearer-token-auth. See apps/ielts-sda-prep-api/README.md.
	handle_path /ielts-sda-prep-api/* {
		reverse_proxy 127.0.0.1:8111 {
			header_up X-Forwarded-Prefix /ielts-sda-prep-api
		}
	}

	# DSA Native — 150-day DSA + AI-native interview prep daily driver.
	# Static SPA + Express /api/sync (MongoDB-backed) hosted in-container
	# (apps/dsa-native). The SPA uses relative URLs (./content.json,
	# ./api/sync) so handle_path's prefix strip is invisible to it.
	# Migrated here from Vercel on 2026-10-14 because the Hobby plan blocked
	# every deploy past the first.
	handle /dsa-native {
		redir * /dsa-native/ permanent
	}
	handle_path /dsa-native/* {
		reverse_proxy 127.0.0.1:8112 {
			header_up X-Forwarded-Prefix /dsa-native
		}
	}

	# Landing page = route map.
	handle / {
		root * /srv
		rewrite * /index.html
		file_server
	}

	handle {
		respond "kajota-hub: unknown route. GET / for the map." 404
	}
}
